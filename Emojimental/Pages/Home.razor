@page "/"

@using System.Threading
@using System.Diagnostics
@implements IDisposable

<PageTitle>Emojimental</PageTitle>

<div class="home-shell">
    <LeftSidebar />
    <Field />
    <TemperatureSidebar />
    <RightSidebar />
</div>

@code {
    private const double LogicTickSeconds = 1.0 / 60.0;
    private const double UiTickSeconds = 1.0 / 20.0; // Slowed down from 30 FPS to 20 FPS
    private const double ResourceTickSeconds = 1.0 / 5.0; // 5 FPS for resources

    [Inject] public required GameState GameState { get; set; }

    private Timer? _logicTimer;
    private Timer? _uiTimer;
    private Timer? _resourceTimer;
    private long _lastTickTimestamp;

    protected override void OnInitialized()
    {
        GameState.RequestUiUpdate += OnRequestUiUpdate;
        _lastTickTimestamp = Stopwatch.GetTimestamp();
        
        // Logic runs at 60 FPS
        _logicTimer = new Timer(_ => TickLogic(), null, TimeSpan.Zero, TimeSpan.FromSeconds(LogicTickSeconds));
        
        // UI updates run at 20 FPS
        _uiTimer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(UiTickSeconds), TimeSpan.FromSeconds(UiTickSeconds));

        // Resource updates run at 5 FPS
        _resourceTimer = new Timer(_ => GameState.NotifyResourceUiUpdate(), null, TimeSpan.FromSeconds(ResourceTickSeconds), TimeSpan.FromSeconds(ResourceTickSeconds));
    }

    private void TickLogic()
    {
        var currentTimestamp = Stopwatch.GetTimestamp();
        var elapsedSeconds = Stopwatch.GetElapsedTime(_lastTickTimestamp, currentTimestamp).TotalSeconds;
        _lastTickTimestamp = currentTimestamp;

        GameState.Advance(elapsedSeconds);
    }

    private void OnRequestUiUpdate() { }

    public void Dispose()
    {
        GameState.RequestUiUpdate -= OnRequestUiUpdate;
        _logicTimer?.Dispose();
        _uiTimer?.Dispose();
        _resourceTimer?.Dispose();
    }
}

@using Emojimental.Models
@using Emojimental.Services
@implements IDisposable
@inject GameState GameState
@inject IJSRuntime JSRuntime

<div class="resource-bar">
    @if (GameState.IsResourceUnlocked(ResourceType.Coin))
    {
        <ResourceItem Type="ResourceType.Coin" Value="GameState.Coin" Label="Coin"/>
    }
    @if (GameState.IsResourceUnlocked(ResourceType.Ice))
    {
        <ResourceItem Type="ResourceType.Ice" Value="GameState.Ice" Label="Snow"/>
    }
    @if (GameState.IsResourceUnlocked(ResourceType.ResearchPoint))
    {
        <ResourceItem Type="ResourceType.ResearchPoint" Value="GameState.ResearchPoint" Label="Research"/>
    }
    @if (GameState.IsResourceUnlocked(ResourceType.Energy))
    {
        <ResourceItem Type="ResourceType.Energy" Value="GameState.Energy" Label="Energy"/>
    }
    @if (GameState.IsResourceUnlocked(ResourceType.Water))
    {
        <ResourceItem Type="ResourceType.Water" Value="GameState.Water" Label="Water"/>
    }
    @if (GameState.IsResourceUnlocked(ResourceType.StarDust))
    {
        <ResourceItem Type="ResourceType.StarDust" Value="GameState.StarDust" Label="StarDust"/>
    }
    @if (GameState.IsResourceUnlocked(ResourceType.Tree))
    {
        <ResourceItem Type="ResourceType.Tree" Value="GameState.Tree" Label="Tree"/>
    }
    @if (GameState.IsResourceUnlocked(ResourceType.Wood))
    {
        <ResourceItem Type="ResourceType.Wood" Value="GameState.Wood" Label="Wood"/>
    }
    @if (GameState.Cheats)
    {
        <button class="cheat-button" @onclick="GameState.CheatResources">@EmojiBank.Symbol(SymbolType.Plus)</button>
    }
    <div class="timer-and-volume">
        <span class="timer">@FormatPlayTime(GameState.PlayTime)</span>
        <div class="volume-control">
            <button class="weather-button" @onclick="GameState.ToggleWeather">
                @(GameState.IsWeatherDisabled ? "🚫🌧️" : "🌧️")
            </button>
            <button class="mute-button" @onclick="ToggleMute">
                @((GameState.IsMuted || GetVolume() == 0) ? "🔇" : EmojiBank.Symbol(SymbolType.Music))
            </button>
            <input type="range" min="0" max="1" step="0.01" value="@GetVolume()" @oninput="UpdateVolume" />
        </div>
    </div>
</div>

@code {
    private static string FormatPlayTime(TimeSpan t)
    {
        var totalSeconds = t.TotalSeconds;
        var hh = (int)totalSeconds / 3600;
        var mm = (int)(totalSeconds / 60) % 60;
        var ss = (int)totalSeconds % 60;
        var ff = (int)((totalSeconds - Math.Truncate(totalSeconds)) * 100);
        return $"{hh:D2}:{mm:D2}:{ss:D2}:{ff:D2}";
    }

    protected override void OnInitialized()
    {
        GameState.RequestResourceUiUpdate += OnRequestUiUpdate;
        GameState.RequestUiUpdate += OnRequestUiUpdate;
    }

    private double GetVolume()
    {
        if (GameState.IsMuted) return 0;
        return GameState.MusicVolume.BaseValue.ToDouble();
    }

    private async Task ToggleMute()
    {
        GameState.ToggleMute();
        await JSRuntime.InvokeVoidAsync("audioManager.setVolume", GetVolume());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var volume = GetVolume();
                await JSRuntime.InvokeVoidAsync("audioManager.playBGM", "audio/theme.mp3", volume);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[DEBUG_LOG] Error playing BGM on first render: {ex.Message}");
            }
        }
    }

    private async Task UpdateVolume(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var volume))
        {
            GameState.SetMusicVolume(volume);
            try
            {
                await JSRuntime.InvokeVoidAsync("audioManager.setVolume", GetVolume());
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[DEBUG_LOG] Error updating volume: {ex.Message}");
            }
        }
    }

    private bool _shouldRender = true;
    private void OnRequestUiUpdate()
    {
        _shouldRender = true;
        InvokeAsync(StateHasChanged);
    }

    protected override bool ShouldRender()
    {
        if (_shouldRender)
        {
            _shouldRender = false;
            return true;
        }
        return false;
    }

    public void Dispose()
    {
        GameState.RequestResourceUiUpdate -= OnRequestUiUpdate;
        GameState.RequestUiUpdate -= OnRequestUiUpdate;
    }
}

@using Emojimental.GameEngine.Values
@using Emojimental.Models
@implements IDisposable
@inject Services.GameState GameState

<section class="left-sidebar__section left-sidebar__section--exchange">
    <div class="left-sidebar__section-header">
        <span class="left-sidebar__section-icon">@EmojiBank.Symbol(SymbolType.Exchange)</span>
    </div>

    @* Snowman Block *@
    <article class="left-sidebar__card left-sidebar__card--exchange left-sidebar__card--compact">
        <div class="left-sidebar__card-header">
            <div>
                <span class="left-sidebar__icon">@EmojiBank.Symbol(SymbolType.Snowman)</span>
                <span class="left-sidebar__count">@GameState.SnowmanCount</span>
            </div>
            <button type="button"
                    class="btn btn-primary btn-sm left-sidebar__wide-button"
                    @onclick="() => GameState.BuySnowman()"
                    disabled="@(!GameState.CanBuySnowman())">
                @GameState.GetSnowmanCost().Display() @EmojiBank.Resource(ResourceType.Ice)
            </button>
        </div>

        <div class="exchange-snowman-content">
            <div class="exchange-line-2">
                @(GameState.SnowmanCoinIncomePerSecond.Display())@EmojiBank.Resource(ResourceType.Coin)
                @if (GameState.HasResearch(ResearchType.UnlockHappiness))
                {
                    <text> </text>@(GameState.SnowmanCarrotIncomePerSecond.Display())@EmojiBank.Resource(ResourceType.Carrot)
                }
                / @EmojiBank.Symbol(SymbolType.Second)
            </div>
        </div>
    </article>

    @* Sapling Block *@
    @if (GameState.HasResearch(ResearchType.UnlockSaplings))
    {
        <article class="left-sidebar__card left-sidebar__card--exchange left-sidebar__card--compact">
            <div class="left-sidebar__card-header">
                <div>
                    <span class="left-sidebar__icon">@EmojiBank.Resource(ResourceType.Sapling)</span>
                    <span class="left-sidebar__count">@GameState.SaplingCount</span>
                </div>
                <button type="button"
                        class="btn btn-primary btn-sm left-sidebar__wide-button"
                        @onclick="() => GameState.BuySapling()"
                        disabled="@(!GameState.CanBuySapling())">
                    @GameState.GetSaplingCost().Display() @EmojiBank.Resource(ResourceType.Coin)
                </button>
            </div>
            <div class="exchange-snowman-content">
                <div class="exchange-line-2">
                    @EmojiBank.Resource(ResourceType.Coin)@GameState.GetSaplingCost().Display() @EmojiBank.Symbol(SymbolType.Arrow) @EmojiBank.Resource(ResourceType.Sapling)
                </div>
            </div>
        </article>
    }

    @* Temperature Block *@
    @if (GameState.HasResearch(ResearchType.UnlockTemperatureExchange))
    {
        <article class="left-sidebar__card left-sidebar__card--exchange left-sidebar__card--compact">
            <div class="left-sidebar__card-header">
                <div>
                    <span class="left-sidebar__icon">@EmojiBank.Symbol(SymbolType.Temperature)</span>
                    <span class="left-sidebar__count">@GameState.MaxTemperatureCelsius</span>
                </div>
                <button type="button"
                        class="btn btn-primary btn-sm left-sidebar__wide-button"
                        @onclick="GameState.BuyTemperatureMax"
                        disabled="@(!GameState.CanBuyTemperatureMax())">
                    @GameState.GetTemperatureMaxCost().Display() @EmojiBank.Resource(ResourceType.Energy)
                </button>
            </div>
            <div class="exchange-snowman-content">
                <div class="exchange-line-2">
                    @EmojiBank.Resource(ResourceType.Energy)@GameState.GetTemperatureMaxCost().Display() @EmojiBank.Symbol(SymbolType.Arrow) ➕1 @EmojiBank.Symbol(SymbolType.Temperature)
                </div>
            </div>
        </article>
    }

    @* Star Improver Block *@
    @if (GameState.HasResearch(ResearchType.UnlockStarImprover))
    {
        <article class="left-sidebar__card left-sidebar__card--exchange left-sidebar__card--compact">
            <div class="left-sidebar__card-header">
                <div>
                    <span class="left-sidebar__icon">🪄</span>
                    <span class="left-sidebar__count">@GameState.EvaluatePassiveStat(PassiveStatType.Stars).Display()</span>
                </div>
                <button type="button"
                        class="btn btn-primary btn-sm left-sidebar__wide-button"
                        @onclick="GameState.UpgradeStars"
                        disabled="@(!GameState.CanUpgradeStars())">
                    @GameState.GetStarUpgradeCost().Display()@EmojiBank.Resource(ResourceType.StarDust)+@GameState.GetStarUpgradeCost().Display()@EmojiBank.Resource(ResourceType.Wood)
                </button>
            </div>
            <div class="exchange-snowman-content">
                <div class="exchange-line-2">
                    @EmojiBank.Resource(ResourceType.StarDust)@GameState.GetStarUpgradeCost().Display()+@EmojiBank.Resource(ResourceType.Wood)@GameState.GetStarUpgradeCost().Display()@EmojiBank.Symbol(SymbolType.Arrow)➕1🪄
                </div>
            </div>
        </article>
    }
</section>

@code {
    private DateTime _lastUpdate = DateTime.MinValue;

    protected override void OnInitialized()
    {
        GameState.RequestUiUpdate += OnRequestUiUpdate;
    }

    private void OnRequestUiUpdate()
    {
        var now = DateTime.UtcNow;
        if ((now - _lastUpdate).TotalMilliseconds >= 500)
        {
            _lastUpdate = now;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        GameState.RequestUiUpdate -= OnRequestUiUpdate;
    }
}

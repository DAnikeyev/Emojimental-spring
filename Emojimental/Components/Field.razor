@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@implements IAsyncDisposable
@inject GameState GameState
@inject IJSRuntime JS

<div class="field-shell">
    <div class="field-surface"
         @ref="_surface"
         style="width:@FieldWidthPx;height:@FieldHeightPx;--sky-color:@SkyColor;"
         data-cycle-phase="@CyclePhase"
         @onclick="OnSurfaceClick"
         @onpointermove="OnPointerMove"
         @onpointerup="OnPointerUp"
         @onpointercancel="OnPointerUp"
         @onpointerleave="OnPointerLeave">
        <div class="field-sky-day"></div>
        <div class="field-celestial-container">
            <div class="field-sun @(IsSunVisible ? "field-celestial--visible" : "")" aria-hidden="true">☀️</div>
            <div class="field-moon @(IsMoonVisible ? "field-celestial--visible" : "")" aria-hidden="true">🌙</div>
        </div>

        @foreach (var beam in GameState.AlignmentBeams)
        {
            <div class="field-beam @(beam.IsHorizontal ? "" : "field-beam--vertical")"
                 style="left:@(beam.Left.ToString("F1", CultureInfo.InvariantCulture))px;top:@(beam.Top.ToString("F1", CultureInfo.InvariantCulture))px;width:@(beam.Width.ToString("F1", CultureInfo.InvariantCulture))px;height:@(beam.Height.ToString("F1", CultureInfo.InvariantCulture))px;">
            </div>
        }
        
        @foreach (var fieldObject in GameState.FieldObjects)
        {
            <FieldNodeItem @key="fieldObject.Id"
                           Node="fieldObject"
                           GameState="GameState"
                           IsDragging="@(_dragState?.FieldObjectId == fieldObject.Id)"
                           IsSelected="@(GameState.SelectedFieldObject?.Id == fieldObject.Id)"
                           OnPointerDown="@(args => OnPointerDown(fieldObject, args))" />
        }
    </div>
</div>

@code {
    private const double DragThreshold = 6d;

    private ElementReference _surface;
    private DotNetObjectReference<Field>? _selfReference;
    private DragState? _dragState;
    private int? _heldFieldObjectId;
    private bool _isObservingSurface;
    private bool _suppressSurfaceClick;
    private bool _disposed;
    private static readonly Random _random = new();

    private string FieldWidthPx => $"{GameState.FieldWidth.ToString("F0", CultureInfo.InvariantCulture)}px";
    private string FieldHeightPx => $"{GameState.FieldHeight.ToString("F0", CultureInfo.InvariantCulture)}px";

    private bool IsSunVisible => GameState.DayCyclePosition is > 0.25 and < 0.75;
    private bool IsMoonVisible => GameState.DayCyclePosition is <= 0.25 or >= 0.75;

    private int _lastStarCycle = -1;
    private readonly Dictionary<int, DateTime> _lastExplosionTimes = new();

    private string _cachedSkyColor = "rgba(44, 62, 120, 0.9)";
    private double _lastDayCyclePosition = -1;
    private double _lastTemperatureProgress = -1;

    private string SkyColor
    {
        get
        {
            var p = GameState.DayCyclePosition;
            var temp = GameState.TemperatureProgress;
            
            // Optimization: Only update sky color if changed significantly
            if (Math.Abs(p - _lastDayCyclePosition) < 0.001 && Math.Abs(temp - _lastTemperatureProgress) < 0.001)
            {
                return _cachedSkyColor;
            }

            _lastDayCyclePosition = p;
            _lastTemperatureProgress = temp;
            
            // 0.0: Midnight
            // 0.25: Dawn
            // 0.5: Midday
            // 0.75: Dusk
            
            // Night: 0.0 - 0.15 and 0.85 - 1.0 -> Blue
            // Dawn/Dusk transitions: 0.15 - 0.25 and 0.75 - 0.85
            // Day: 0.25 - 0.75 -> Yellow
            
            var nightColor = (44, 62, 120, 90, 100, 160); // Blue-ish night
            var dayColor = (255, 245, 150, 255, 220, 100); // Yellow-ish day
            var transitionColor = (255, 180, 120, 255, 140, 80); // Orange-ish dawn/dusk

            if (p is >= 0.25 and <= 0.75) _cachedSkyColor = MixedColor(dayColor);
            else if (p < 0.15 || p > 0.85) _cachedSkyColor = MixedColor(nightColor);
            else if (p >= 0.15 && p < 0.2) _cachedSkyColor = InterpolateMixed(nightColor, transitionColor, (p - 0.15) / 0.05);
            else if (p >= 0.2 && p < 0.25) _cachedSkyColor = InterpolateMixed(transitionColor, dayColor, (p - 0.2) / 0.05);
            else if (p > 0.75 && p <= 0.8) _cachedSkyColor = InterpolateMixed(dayColor, transitionColor, (p - 0.75) / 0.05);
            else if (p > 0.8 && p <= 0.85) _cachedSkyColor = InterpolateMixed(transitionColor, nightColor, (p - 0.8) / 0.05);
            else _cachedSkyColor = MixedColor(nightColor);

            return _cachedSkyColor;
        }
    }

    private double DayNightDarkeningFactor
    {
        get
        {
            var dayP = GameState.DayCyclePosition;
            return 0.85 + 0.15 * Math.Cos((dayP - 0.5) * 2.0 * Math.PI);
        }
    }

    private string MixedColor((int r1, int g1, int b1, int r2, int g2, int b2) colors)
    {
        var factor = DayNightDarkeningFactor;
        var dr1 = (int)(colors.r1 * factor);
        var dg1 = (int)(colors.g1 * factor);
        var db1 = (int)(colors.b1 * factor);
        var dr2 = (int)(colors.r2 * factor);
        var dg2 = (int)(colors.g2 * factor);
        var db2 = (int)(colors.b2 * factor);
        return GameState.MixColor(dr1, dg1, db1, dr2, dg2, db2, GameState.TemperatureProgress);
    }

    private string InterpolateMixed((int r1, int g1, int b1, int r2, int g2, int b2) c1, (int r1, int g1, int b1, int r2, int g2, int b2) c2, double t)
    {
        int r1 = (int)(c1.r1 + (c2.r1 - c1.r1) * t);
        int g1 = (int)(c1.g1 + (c2.g1 - c1.g1) * t);
        int b1 = (int)(c1.b1 + (c2.b1 - c1.b1) * t);
        
        int r2 = (int)(c1.r2 + (c2.r2 - c1.r2) * t);
        int g2 = (int)(c1.g2 + (c2.g2 - c1.g2) * t);
        int b2 = (int)(c1.b2 + (c2.b2 - c1.b2) * t);

        var factor = DayNightDarkeningFactor;
        r1 = (int)(r1 * factor);
        g1 = (int)(g1 * factor);
        b1 = (int)(b1 * factor);
        r2 = (int)(r2 * factor);
        g2 = (int)(g2 * factor);
        b2 = (int)(b2 * factor);

        return GameState.MixColor(r1, g1, b1, r2, g2, b2, GameState.TemperatureProgress);
    }

    private string CyclePhase
    {
        get
        {
            var p = GameState.DayCyclePosition;
            if (p is >= 0.25 and <= 0.75) return "day";
            return "night";
        }
    }

    protected override void OnInitialized()
    {
        GameState.Changed += OnGameStateChanged;
        GameState.RequestUiUpdate += OnRequestUiUpdate;
        GameState.OnResourceProduced += OnResourceProduced;

        // Initialize _lastStarCycle to current cycle to avoid triggering event on launch
        _lastStarCycle = (int)Math.Floor(GameState.PlayTime.TotalSeconds / GameState.DayCycleDurationSeconds);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _selfReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("emojimentalField.observeSize", _surface, _selfReference);
        _isObservingSurface = true;
    }

    private void OnPointerDown(FieldNode fieldObject, PointerEventArgs args)
    {
        var pointerOffsetX = GetSurfacePointerX(args) - fieldObject.X;
        var pointerOffsetY = GetSurfacePointerY(args) - fieldObject.Y;

        GameState.SelectFieldObject(fieldObject.Id);
        _dragState = new DragState(
            fieldObject.Id,
            args.ClientX,
            args.ClientY,
            pointerOffsetX,
            pointerOffsetY,
            false);
        _heldFieldObjectId = fieldObject.Id;
        GameState.SetFieldNodeHeld(fieldObject.Id, true);
    }

    private void OnPointerMove(PointerEventArgs args)
    {
        if (_dragState is null)
            return;

        var deltaX = args.ClientX - _dragState.Value.StartClientX;
        var deltaY = args.ClientY - _dragState.Value.StartClientY;
        if (!_dragState.Value.HasMoved && Math.Sqrt(deltaX * deltaX + deltaY * deltaY) < DragThreshold)
            return;

        if (!_dragState.Value.HasMoved)
            _dragState = _dragState.Value with { HasMoved = true };

        var targetX = GetSurfacePointerX(args) - _dragState.Value.PointerOffsetX;
        var targetY = GetSurfacePointerY(args) - _dragState.Value.PointerOffsetY;
        GameState.MoveFieldObject(_dragState.Value.FieldObjectId, targetX, targetY);
    }

    private void OnPointerUp(PointerEventArgs _)
    {
        if (_heldFieldObjectId is int heldId)
        {
            GameState.SetFieldNodeHeld(heldId, false);
            _heldFieldObjectId = null;
        }

        if (_dragState is null)
            return;

        var dragState = _dragState.Value;
        if (dragState.HasMoved)
        {
            _suppressSurfaceClick = true;
        }
        else
        {
            GameState.SelectFieldObject(dragState.FieldObjectId);
        }

        _dragState = null;
    }

    private void OnPointerLeave(PointerEventArgs _)
    {
        if (_heldFieldObjectId is int heldId)
        {
            GameState.SetFieldNodeHeld(heldId, false);
            _heldFieldObjectId = null;
        }

        _dragState = null;
    }

    private void OnSurfaceClick()
    {
        if (_suppressSurfaceClick)
        {
            _suppressSurfaceClick = false;
            return;
        }

        GameState.SelectFieldObject(null);
    }

    private void OnBeamStarDrop(int sourceFieldNodeId, FieldNodeSide sourceSide, DragEventArgs _)
    {
        GameState.TryPlaceStar(sourceFieldNodeId, sourceSide);
    }


    private void OnGameStateChanged()
    {
        // Handled by RequestUiUpdate
    }

    private bool _shouldRender = true;
    private void OnRequestUiUpdate()
    {
        UpdateStarEvent();
        _shouldRender = true;
        InvokeAsync(StateHasChanged);
    }

    protected override bool ShouldRender()
    {
        if (_shouldRender)
        {
            _shouldRender = false;
            return true;
        }
        return false;
    }

    private async void OnResourceProduced(FieldNode node, int cycles)
    {
        if (!GameState.ParticlesEnabled) return;

        var now = DateTime.UtcNow;
        // Optimization: Further throttle particles per node
        if (_lastExplosionTimes.TryGetValue(node.Id, out var lastTime) && (now - lastTime).TotalSeconds < 1.0)
        {
            return;
        }
        _lastExplosionTimes[node.Id] = now;

        var countPerCompletion = Math.Min(3, (int)Math.Floor(1 + Math.Log(node.Level, 2.0)));
        var count = (int)Math.Ceiling(countPerCompletion * Math.Max(1, cycles) / 20.0);
        if (count <= 0) count = 1;
        if (count > 5) count = 5;
        
        try
        {
            var x = (node.X + FieldNode.Size / 2);
            var y = (node.Y + FieldNode.Size / 2);
            var icon = node.ResourceIcon;

            _ = JS.InvokeVoidAsync("emojimentalSnowfall.addResourceParticlesRelative", _surface, x, y, icon, count, 0.5);
        }
        catch
        {
            // Ignore errors if surface is not ready or JS is disconnected
        }
    }

    private void UpdateStarEvent()
    {
        if (!GameState.HasResearch(ResearchType.UnlockStars)) return;

        var p = GameState.DayCyclePosition;
        // Midnight is at p = 0.
        
        var currentCycle = (int)Math.Floor(GameState.PlayTime.TotalSeconds / GameState.DayCycleDurationSeconds);
        // Trigger right at the start of a new cycle (midnight)
        if (currentCycle > _lastStarCycle)
        {
            _lastStarCycle = currentCycle;
            var starsToSpawn = (int)GameState.EvaluatePassiveStat(PassiveStatType.Stars).ToDouble();
            for (int i = 0; i < starsToSpawn; i++)
            {
                // Pre-generate star to avoid changes in stats affecting generation mid-fall
                var star = GameState.GenerateRandomStar();
                // Spread out spawning slightly if multiple stars
                var delayMs = starsToSpawn > 1 ? (int)(5000.0 * i / (starsToSpawn - 1)) : 0;
                _ = RunSingleStarFall(star, delayMs);
            }
        }
    }

    private static bool UsesFastProgressIndicator(FieldNode fieldObject)
    {
        var cooldownSeconds = fieldObject.EvaluateCooldown().ToDouble();
        return !double.IsNaN(cooldownSeconds)
               && !double.IsInfinity(cooldownSeconds)
               && cooldownSeconds <= 0.2d;
    }

    private async Task RunSingleStarFall(Star star, int delayMs)
    {
        try
        {
            if (delayMs > 0)
            {
                await Task.Delay(delayMs);
            }

            // Meteorite behavior: flies from the sky to the ground
            // Field bottom is y=100 (in %)
            // Pick a random X for landing
            var startX = 20 + _random.NextDouble() * 70;
            var startY = -10.0;
            var targetX = 20 + _random.NextDouble() * 60;
            var targetY = 95.0;

            var steps = 30; // Fewer steps for less JS interop
            var currentX = startX;
            var currentY = startY;

            for (int i = 0; i <= steps; i++)
            {
                var t = i / (double)steps;
                // Cubic ease-in for a "falling" feel
                var easeT = t * t * t; 
                currentX = startX + (targetX - startX) * t;
                currentY = startY + (targetY - startY) * easeT;

                if (i % 2 == 0)
                {
                    _ = JS.InvokeVoidAsync("emojimentalSnowfall.addStarTrailRelative", _surface, currentX, currentY);
                }

                await Task.Delay(32); // 30 FPS for animation
            }

            // Explode
            if (GameState.ParticlesEnabled)
            {
                _ = JS.InvokeVoidAsync("emojimentalSnowfall.addStarExplosionRelative", _surface, currentX, currentY, 6);
            }
            GameState.AddStarToInventory(star);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DEBUG_LOG] Error in RunSingleStarFall: {ex}");
        }
    }

    [JSInvokable]
    public Task OnSurfaceResized(double width, double height, double renderedWidth, double renderedHeight, double renderedLeft, double renderedTop)
    {
        _surfaceLogicalWidth = width;
        _surfaceLogicalHeight = height;
        _surfaceRenderedWidth = renderedWidth;
        _surfaceRenderedHeight = renderedHeight;
        _surfaceRenderedLeft = renderedLeft;
        _surfaceRenderedTop = renderedTop;
        GameState.SetFieldSize(width, height);
        return Task.CompletedTask;
    }

    private double ScaleX => _surfaceLogicalWidth <= 0 ? 1 : _surfaceRenderedWidth / _surfaceLogicalWidth;

    private double ScaleY => _surfaceLogicalHeight <= 0 ? 1 : _surfaceRenderedHeight / _surfaceLogicalHeight;

    private double GetSurfacePointerX(PointerEventArgs args)
        => (args.ClientX - _surfaceRenderedLeft) / ScaleX;

    private double GetSurfacePointerY(PointerEventArgs args)
        => (args.ClientY - _surfaceRenderedTop) / ScaleY;

    public void Dispose()
    {
        if (_disposed)
            return;

        _disposed = true;
        GameState.Changed -= OnGameStateChanged;
        GameState.RequestUiUpdate -= OnRequestUiUpdate;
        GameState.OnResourceProduced -= OnResourceProduced;
        _selfReference?.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (!_isObservingSurface)
            return;

        try
        {
            await JS.InvokeVoidAsync("emojimentalField.disposeSizeObserver", _surface);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private readonly record struct DragState(
        int FieldObjectId,
        double StartClientX,
        double StartClientY,
        double PointerOffsetX,
        double PointerOffsetY,
        bool HasMoved);

    private double _surfaceLogicalWidth = 1;
    private double _surfaceLogicalHeight = 1;
    private double _surfaceRenderedWidth = 1;
    private double _surfaceRenderedHeight = 1;
    private double _surfaceRenderedLeft;
    private double _surfaceRenderedTop;

    private readonly record struct FieldBounds(double Left, double Top);
}


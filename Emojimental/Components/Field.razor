@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@implements IAsyncDisposable
@inject GameState GameState
@inject IJSRuntime JS

<div class="field-shell">
    <div class="field-surface"
         @ref="_surface"
         style="width:@FieldWidthPx;height:@FieldHeightPx;"
         @onclick="OnSurfaceClick"
         @onpointermove="OnPointerMove"
         @onpointerup="OnPointerUp"
         @onpointercancel="OnPointerUp"
         @onpointerleave="OnPointerLeave">
        <div class="field-sky-day" style="opacity:@SkyDayOpacity.ToString("F2", CultureInfo.InvariantCulture);"></div>
        <div class="field-celestial-container">
            <div class="field-sun @(IsSunVisible ? "field-celestial--visible" : "")" aria-hidden="true">☀️</div>
            <div class="field-moon @(IsMoonVisible ? "field-celestial--visible" : "")" aria-hidden="true">🌙</div>
        </div>

        @foreach (var beam in GameState.AlignmentBeams)
        {
            <div class="field-beam @(beam.IsHorizontal ? "" : "field-beam--vertical")"
                 style="left:@(beam.Left.ToString("F1", CultureInfo.InvariantCulture))px;top:@(beam.Top.ToString("F1", CultureInfo.InvariantCulture))px;width:@(beam.Width.ToString("F1", CultureInfo.InvariantCulture))px;height:@(beam.Height.ToString("F1", CultureInfo.InvariantCulture))px;">
            </div>
        }
        
        @foreach (var star in _activeStars)
        {
            <div class="field-star-event @(star.IsExploding ? "field-star-event--exploding" : "")" 
                 style="left: @($"{star.X.ToString("F1", CultureInfo.InvariantCulture)}%") ; top: @($"{star.Y.ToString("F1", CultureInfo.InvariantCulture)}%") ;">
            </div>
        }

        @foreach (var fieldObject in GameState.FieldObjects)
        {
            var fieldObjectClasses = GetFieldObjectClasses(fieldObject, _dragState?.FieldObjectId, GameState.SelectedFieldObject?.Id);

            <div class="@fieldObjectClasses"
                 style="left:@(fieldObject.X.ToString("F1", CultureInfo.InvariantCulture))px;top:@(fieldObject.Y.ToString("F1", CultureInfo.InvariantCulture))px;width:@(FieldNode.Size.ToString("F0", CultureInfo.InvariantCulture))px;height:@(FieldNode.Size.ToString("F0", CultureInfo.InvariantCulture))px;"
                 @onpointerdown="@(args => OnPointerDown(fieldObject, args))"
                 @onpointerdown:preventDefault="true"
                 @onclick:stopPropagation="true"
                 aria-label="Open @fieldObject.TypeDisplayName details">
                 <div class="field-node__type">@fieldObject.Icon</div>

                 @if (fieldObject.Type == FieldNodeType.Builder)
                 {
                     <button type="button"
                             class="field-node__lever"
                            @onclick="@(() => GameState.ToggleFieldObjectLever(fieldObject.Id))"
                            @onclick:stopPropagation="true"
                            @onpointerdown:stopPropagation="true"
                            title="Toggle Market/House">
                        @(fieldObject.BuilderLever == 0 ? "⚖️" : "🏠")
                    </button>
                }

                <div class="field-node__progress" aria-label="@fieldObject.TypeDisplayName progress">
                    @if (UsesFastProgressIndicator(fieldObject))
                    {
                        <div class="field-node__progress-fast" aria-hidden="true">@EmojiBank.Symbol(SymbolType.FastProgress)</div>
                    }
                    else
                    {
                        <div class="field-node__progress-fill"
                             style="width:@FormatPercent(fieldObject.ProgressPercent)"></div>
                    }
                </div>

                <div class="field-node__stats field-node__stats--top">
                    <span>@EmojiBank.Symbol(SymbolType.Second) @fieldObject.CooldownDisplay() <span class="base-value">(@fieldObject.BaseCooldownDisplay())</span></span>
                </div>

                <div class="field-node__core @(fieldObject.Type == FieldNodeType.Bonfire ? "field-node__core--compact" : string.Empty)">
                    <span>@fieldObject.Type.Effect()</span>
                </div>

                @if (fieldObject.Type == FieldNodeType.Recycler)
                {
                    <div class="field-node__recycler-drop @(GameState.DraggingStarSlotIndex is not null ? "field-node__recycler-drop--active" : "")"
                         @ondragover:preventDefault="true"
                         @ondrop="@(() => GameState.TryPlaceStarInRecycler(fieldObject.Id))"
                         @onclick:stopPropagation="true"
                         @onpointerdown:stopPropagation="true">
                        @EmojiBank.Symbol(SymbolType.Stars)
                        @if (fieldObject.RecycleQueue > 0)
                        {
                            <span class="field-node__recycler-queue">@fieldObject.RecycleQueue</span>
                        }
                    </div>
                }

                @foreach (var beamStarSlot in GetBeamStarSlots(fieldObject.Id))
                {
                    <div class="@GetBeamStarSlotClasses(beamStarSlot)"
                         @ondragover:preventDefault="true"
                         @ondrop="@(args => OnBeamStarDrop(beamStarSlot.SourceFieldNodeId, beamStarSlot.SourceSide, args))"
                         @onclick:stopPropagation="true"
                         @onpointerdown:stopPropagation="true"
                         aria-label="Star slot">
                        @if (beamStarSlot.HasStar)
                        {
                            <div class="field-node__star-shell">
                                <button type="button"
                                        class="field-node__star"
                                        @onclick:stopPropagation="true"
                                        @onpointerdown:stopPropagation="true"
                                        aria-label="Star modifiers">
                                    <div class="left-sidebar__star-icon @GetStarIconClasses(beamStarSlot.Star!)">
                                        @EmojiBank.Symbol(SymbolType.Stars)
                                    </div>
                                </button>

                                <dl class="field-node__star-popup" aria-label="Star modifiers">
                                    @if (beamStarSlot.Star!.Type == StarType.Yellow || beamStarSlot.Star!.Type == StarType.Legendary)
                                    {
                                        <div>
                                            <dt>@EmojiBank.Symbol(SymbolType.Factory) @EmojiBank.Symbol(SymbolType.Multiply)</dt>
                                            <dd>@beamStarSlot.Star!.ProductionMultiplier.Display()</dd>
                                        </div>
                                    }
                                    @if (beamStarSlot.Star!.Type == StarType.Blue || beamStarSlot.Star!.Type == StarType.Legendary)
                                    {
                                        <div>
                                            <dt>@EmojiBank.Symbol(SymbolType.Second) @EmojiBank.Symbol(SymbolType.Minus)</dt>
                                            <dd>@beamStarSlot.Star!.CooldownReduction.ToString("F2")</dd>
                                        </div>
                                    }
                                </dl>
                            </div>
                        }
                    </div>
                }

                <div class="field-node__stats field-node__stats--bottom">
                    <span>@fieldObject.ResourceIcon @GameState.GetDisplayedFactoryValue(fieldObject).Display() <span class="base-value">(@GameState.GetDisplayedFactoryBaseValue(fieldObject).Display())</span></span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private const double DragThreshold = 6d;

    private ElementReference _surface;
    private DotNetObjectReference<Field>? _selfReference;
    private DragState? _dragState;
    private int? _heldFieldObjectId;
    private bool _isObservingSurface;
    private bool _suppressSurfaceClick;
    private bool _disposed;
    private static readonly Random _random = new();

    private string FieldWidthPx => $"{GameState.FieldWidth.ToString("F0", CultureInfo.InvariantCulture)}px";
    private string FieldHeightPx => $"{GameState.FieldHeight.ToString("F0", CultureInfo.InvariantCulture)}px";

    private bool IsSunVisible => GameState.DayCyclePosition is > 0.25 and < 0.75;
    private bool IsMoonVisible => GameState.DayCyclePosition is <= 0.25 or >= 0.75;

    private int _lastStarCycle = -1;
    private readonly List<StarVisual> _activeStars = new();

    private class StarVisual
    {
        public double X { get; set; }
        public double Y { get; set; }
        public bool IsExploding { get; set; }
    }

    private double SkyDayOpacity
    {
        get
        {
            var p = GameState.DayCyclePosition;
            // MidNight is 0. MidDay is 0.5.
            // Sun is visible from 0.25 to 0.75.
            // Dawn: 0.15 to 0.35?
            // Let's say:
            // 0.0 - 0.2: Night
            // 0.2 - 0.3: Dawn
            // 0.3 - 0.7: Day
            // 0.7 - 0.8: Dusk
            // 0.8 - 1.0: Night
            if (p is >= 0.2 and <= 0.3) return (p - 0.2) / 0.1;
            if (p is > 0.3 and < 0.7) return 1.0;
            if (p is >= 0.7 and <= 0.8) return (0.8 - p) / 0.1;
            return 0.0;
        }
    }

    protected override void OnInitialized()
    {
        GameState.Changed += OnGameStateChanged;
        GameState.RequestUiUpdate += OnRequestUiUpdate;
        GameState.OnResourceProduced += OnResourceProduced;

        // Initialize _lastStarCycle to current cycle to avoid triggering event on launch
        _lastStarCycle = (int)Math.Floor(GameState.PlayTime.TotalSeconds / 30.0);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _selfReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("emojimentalField.observeSize", _surface, _selfReference);
        _isObservingSurface = true;
    }

    private void OnPointerDown(FieldNode fieldObject, PointerEventArgs args)
    {
        var pointerOffsetX = GetSurfacePointerX(args) - fieldObject.X;
        var pointerOffsetY = GetSurfacePointerY(args) - fieldObject.Y;

        GameState.SelectFieldObject(fieldObject.Id);
        _dragState = new DragState(
            fieldObject.Id,
            args.ClientX,
            args.ClientY,
            pointerOffsetX,
            pointerOffsetY,
            false);
        _heldFieldObjectId = fieldObject.Id;
        GameState.SetFieldNodeHeld(fieldObject.Id, true);
    }

    private void OnPointerMove(PointerEventArgs args)
    {
        if (_dragState is null)
            return;

        var deltaX = args.ClientX - _dragState.Value.StartClientX;
        var deltaY = args.ClientY - _dragState.Value.StartClientY;
        if (!_dragState.Value.HasMoved && Math.Sqrt(deltaX * deltaX + deltaY * deltaY) < DragThreshold)
            return;

        if (!_dragState.Value.HasMoved)
            _dragState = _dragState.Value with { HasMoved = true };

        var targetX = GetSurfacePointerX(args) - _dragState.Value.PointerOffsetX;
        var targetY = GetSurfacePointerY(args) - _dragState.Value.PointerOffsetY;
        GameState.MoveFieldObject(_dragState.Value.FieldObjectId, targetX, targetY);
    }

    private void OnPointerUp(PointerEventArgs _)
    {
        if (_heldFieldObjectId is int heldId)
        {
            GameState.SetFieldNodeHeld(heldId, false);
            _heldFieldObjectId = null;
        }

        if (_dragState is null)
            return;

        var dragState = _dragState.Value;
        if (dragState.HasMoved)
        {
            _suppressSurfaceClick = true;
        }
        else
        {
            GameState.SelectFieldObject(dragState.FieldObjectId);
        }

        _dragState = null;
    }

    private void OnPointerLeave(PointerEventArgs _)
    {
        if (_heldFieldObjectId is int heldId)
        {
            GameState.SetFieldNodeHeld(heldId, false);
            _heldFieldObjectId = null;
        }

        _dragState = null;
    }

    private void OnSurfaceClick()
    {
        if (_suppressSurfaceClick)
        {
            _suppressSurfaceClick = false;
            return;
        }

        GameState.SelectFieldObject(null);
    }

    private void OnBeamStarDrop(int sourceFieldNodeId, FieldNodeSide sourceSide, DragEventArgs _)
    {
        GameState.TryPlaceStar(sourceFieldNodeId, sourceSide);
    }


    private void OnGameStateChanged()
    {
        // Handled by RequestUiUpdate
    }

    private void OnRequestUiUpdate()
    {
        UpdateStarEvent();
        InvokeAsync(StateHasChanged);
    }

    private async void OnResourceProduced(FieldNode node, int cycles)
    {
        var countPerCompletion = Math.Min(5, (int)Math.Floor(1 + Math.Log(node.Level, 1.5)));
        var count = countPerCompletion * Math.Max(1, cycles);
        
        try
        {
            var bounds = await JS.InvokeAsync<FieldBounds>("emojimentalField.getBounds", _surface);
            
            var x = (bounds.Left + node.X + FieldNode.Size / 2) / (double)await JS.InvokeAsync<int>("eval", "window.innerWidth") * 100;
            var y = (bounds.Top + node.Y + FieldNode.Size / 2) / (double)await JS.InvokeAsync<int>("eval", "window.innerHeight") * 100;
            var icon = node.ResourceIcon;

            _ = JS.InvokeVoidAsync("emojimentalSnowfall.addResourceParticles", x, y, icon, count, 0.5);
        }
        catch
        {
            // Ignore errors if surface is not ready or JS is disconnected
        }
    }

    private void UpdateStarEvent()
    {
        if (!GameState.HasResearch(ResearchType.UnlockStars)) return;

        var p = GameState.DayCyclePosition;
        // Midnight is at p = 0.
        
        if (p < 0.05 && _activeStars.Count == 0)
        {
            var currentCycle = (int)Math.Floor(GameState.PlayTime.TotalSeconds / 30.0);
            if (currentCycle > _lastStarCycle)
            {
                _lastStarCycle = currentCycle;
                var starsToSpawn = (int)GameState.EvaluatePassiveStat(PassiveStatType.Stars).ToDouble();
                for (int i = 0; i < starsToSpawn; i++)
                {
                    var delayMs = starsToSpawn > 1 ? (int)(10000.0 * i / (starsToSpawn - 1)) : 0;
                    _ = RunSingleStarFall(delayMs);
                }
            }
        }
    }

    private static bool UsesFastProgressIndicator(FieldNode fieldObject)
    {
        var cooldownSeconds = fieldObject.EvaluateCooldown().ToDouble();
        return !double.IsNaN(cooldownSeconds)
               && !double.IsInfinity(cooldownSeconds)
               && cooldownSeconds <= 0.2d;
    }

    private async Task RunSingleStarFall(int delayMs)
    {
        if (delayMs > 0)
        {
            await Task.Delay(delayMs);
        }

        var star = new StarVisual
        {
            X = 90.0,
            Y = 5.0,
            IsExploding = false
        };

        lock (_activeStars)
        {
            _activeStars.Add(star);
        }

        // Meteorite behavior: flies to the ground (bottom of field)
        // Field bottom is y=100 (in %)
        // Let's pick a random X for landing
        var targetX = 20 + _random.NextDouble() * 60;
        var targetY = 95;

        var steps = 40;
        var startX = star.X;
        var startY = star.Y;
        
        for (int i = 0; i <= steps; i++)
        {
            var t = i / (double)steps;
            star.X = startX + (targetX - startX) * t;
            star.Y = startY + (targetY - startY) * t;
            
            _ = JS.InvokeVoidAsync("emojimentalSnowfall.addStarTrail", star.X, star.Y);
            
            StateHasChanged();
            await Task.Delay(16);
        }

        // Explode
        star.IsExploding = true;
        _ = JS.InvokeVoidAsync("emojimentalSnowfall.addStarExplosion", star.X, star.Y);
        StateHasChanged();
        
        GameState.AddStarToInventory();
        
        await Task.Delay(500);
        
        lock (_activeStars)
        {
            _activeStars.Remove(star);
        }
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnSurfaceResized(double width, double height, double renderedWidth, double renderedHeight, double renderedLeft, double renderedTop)
    {
        _surfaceLogicalWidth = width;
        _surfaceLogicalHeight = height;
        _surfaceRenderedWidth = renderedWidth;
        _surfaceRenderedHeight = renderedHeight;
        _surfaceRenderedLeft = renderedLeft;
        _surfaceRenderedTop = renderedTop;
        GameState.SetFieldSize(width, height);
        return Task.CompletedTask;
    }

    private double ScaleX => _surfaceLogicalWidth <= 0 ? 1 : _surfaceRenderedWidth / _surfaceLogicalWidth;

    private double ScaleY => _surfaceLogicalHeight <= 0 ? 1 : _surfaceRenderedHeight / _surfaceLogicalHeight;

    private double GetSurfacePointerX(PointerEventArgs args)
        => (args.ClientX - _surfaceRenderedLeft) / ScaleX;

    private double GetSurfacePointerY(PointerEventArgs args)
        => (args.ClientY - _surfaceRenderedTop) / ScaleY;


    private static string FormatPercent(double value)
        => string.Create(CultureInfo.InvariantCulture, $"{value:F1}%");

    private IEnumerable<BeamStarSlot> GetBeamStarSlots(int fieldObjectId)
    {
        if (!GameState.AreFactoryStarSlotsUnlocked())
            yield break;

        // Pre-group once per render to avoid O(N²) scanning
        var allSlots = GameState.BeamStarSlots;
        for (var i = 0; i < allSlots.Count; i++)
        {
            var slot = allSlots[i];
            if (slot.SourceFieldNodeId == fieldObjectId)
                yield return slot;
        }
    }

    private string GetBeamStarSlotClasses(BeamStarSlot beamStarSlot)
    {
        // Build in-place without intermediate List<string> allocation
        var hasStar = beamStarSlot.HasStar;
        if (hasStar)
            return $"field-node__beam-slot field-node__beam-slot--{beamStarSlot.SourceSide.ToString().ToLowerInvariant()} field-node__beam-slot--filled";

        if (GameState.CanPlaceStar(beamStarSlot.SourceFieldNodeId, beamStarSlot.SourceSide))
            return $"field-node__beam-slot field-node__beam-slot--{beamStarSlot.SourceSide.ToString().ToLowerInvariant()} field-node__beam-slot--glow";

        return $"field-node__beam-slot field-node__beam-slot--{beamStarSlot.SourceSide.ToString().ToLowerInvariant()}";
    }

    private static string GetStarIconClasses(Star star)
        => star.Type switch
        {
            StarType.Legendary => "star--legendary",
            StarType.Blue => "star--rare",
            _ => string.Empty
        };

    private static string GetFieldObjectClasses(FieldNode fieldObject, int? draggingId, int? selectedId)
    {
        var classes = new List<string> { "field-node", $"field-node--{fieldObject.Type.CssModifier()}" };
        if (draggingId == fieldObject.Id) classes.Add("field-node--dragging");
        if (selectedId == fieldObject.Id) classes.Add("field-node--selected");
        if (fieldObject.IsPaused) classes.Add("field-node--paused");
        if (!fieldObject.IsActive) classes.Add("field-node--inactive");
        return string.Join(" ", classes);
    }

    public void Dispose()
    {
        if (_disposed)
            return;

        _disposed = true;
        GameState.Changed -= OnGameStateChanged;
        GameState.RequestUiUpdate -= OnRequestUiUpdate;
        GameState.OnResourceProduced -= OnResourceProduced;
        _selfReference?.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (!_isObservingSurface)
            return;

        try
        {
            await JS.InvokeVoidAsync("emojimentalField.disposeSizeObserver", _surface);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private readonly record struct DragState(
        int FieldObjectId,
        double StartClientX,
        double StartClientY,
        double PointerOffsetX,
        double PointerOffsetY,
        bool HasMoved);

    private double _surfaceLogicalWidth = 1;
    private double _surfaceLogicalHeight = 1;
    private double _surfaceRenderedWidth = 1;
    private double _surfaceRenderedHeight = 1;
    private double _surfaceRenderedLeft;
    private double _surfaceRenderedTop;

    private readonly record struct FieldBounds(double Left, double Top);
}


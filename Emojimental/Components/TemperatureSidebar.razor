@implements IDisposable
@inject GameState GameState
@inject IJSRuntime JS

@using Emojimental.Models
<aside class="temperature-sidebar" style="@_themeStyle">
    <div class="temperature-sidebar__top">
        @if (GameState.CanAdjustTemperature())
        {
            <div class="temperature-sidebar__slider-shell">
                @if (GameState.HasResearch(ResearchType.UnlockGoal))
                {
                    <div class="temperature-sidebar__goal" aria-label="Final goal">
                        <span class="temperature-sidebar__goal-icon">@EmojiBank.Symbol(SymbolType.Goal)</span>
                    </div>
                }
                <div class="temperature-sidebar__vslider">
                    <div class="temperature-sidebar__vslider-track">
                        <div class="temperature-sidebar__vslider-gutter"
                             @ref="_trackRef"
                             role="slider"
                             tabindex="0"
                             aria-valuemin="@SliderMin"
                             aria-valuemax="@SliderMax"
                             aria-valuenow="@GameState.TemperatureCelsius"
                             aria-valuetext="@(GameState.TemperatureCelsius + "°C")"
                             aria-label="Temperature in degrees Celsius"
                             @onpointerdown="OnPointerDown"
                             @onpointerdown:preventDefault="true"
                             @onpointermove="OnPointerMove"
                             @onpointerup="OnPointerUp"
                             @onpointercancel="OnPointerUp"
                             @onkeydown="OnKeyDown">
                            <div class="temperature-sidebar__vslider-rail"
                                 style="@_railStyle"
                                 aria-hidden="true"></div>
                            <div class="temperature-sidebar__vslider-thumb"
                                 style="top:@ThumbOffsetPercent()"
                                 aria-hidden="true"></div>

                            @foreach (var mark in VisibleTemperatureMarks())
                            {
                                <div class="temperature-sidebar__vslider-mark" style="top:@MarkOffsetPercent(mark)">
                                    <span class="temperature-sidebar__vslider-tick" aria-hidden="true"></span>
                                    <span class="temperature-sidebar__vslider-label">@mark</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="temperature-sidebar__bottom">
        @if (GameState.CanAdjustTemperature())
        {
            <div class="temperature-sidebar__temp-info">
                <div class="temperature-sidebar__current">@EmojiBank.Symbol(SymbolType.Temperature) @GameState.TemperatureCelsius°</div>

                <div class="temperature-sidebar__bonuses">
                    <div class="temperature-sidebar__bonus">
                        <span>@EmojiBank.Resource(ResourceType.Ice) @FormatBonus(GameState.GetSnowTemperatureBonusPercent())</span>
                        <span>@EmojiBank.Resource(ResourceType.Water) @FormatBonus(GameState.GetWaterTemperatureBonusPercent())</span>
                        <span>@EmojiBank.Resource(ResourceType.Energy) @FormatBonus(GameState.GetEnergyTemperatureBonusPercent())</span>
                    </div>
                </div>
            </div>
            <div class="temperature-sidebar__separator"></div>
        }
        <div class="temperature-sidebar__clock" aria-label="Day-night cycle">
            <div class="temperature-sidebar__clock-face">
                <span class="temperature-sidebar__clock-sun" aria-hidden="true">@EmojiBank.Symbol(SymbolType.Sun)</span>
                <span class="temperature-sidebar__clock-moon" aria-hidden="true">@EmojiBank.Symbol(SymbolType.Moon)</span>
                <div class="temperature-sidebar__clock-hand"
                     style="transform: rotate(@ClockHandAngleDeg().ToString("F1", System.Globalization.CultureInfo.InvariantCulture)deg)">
                </div>
                <div class="temperature-sidebar__clock-center"></div>
            </div>
        </div>
        <div class="temperature-sidebar__daynight-bonus">
            <span>@EmojiBank.Resource(ResourceType.Energy)</span>
            <span>@FormatBonus(DayNightEnergyBonusPercent())</span>
        </div>
        <div class="temperature-sidebar__date">@CurrentDateDisplay()</div>
    </div>
</aside>

@code {
    private const int SliderMin = GameState.MinTemperatureCelsius;
    private static readonly DateTime GameStartDate = new(2026, 4, 1);
    private static readonly DateTime GameEndDate = new(2026, 5, 31);
    private int SliderMax => GameState.GoalTemperatureCelsius;

    private ElementReference _trackRef;
    private TrackBounds? _dragBounds;
    private bool _pointerActive;

    protected override void OnInitialized()
    {
        GameState.Changed += OnGameStateChanged;
        GameState.RequestUiUpdate += OnRequestUiUpdate;
    }

    private void OnGameStateChanged()
    {
        // Handled by RequestUiUpdate
    }

    private string _themeStyle = "color:initial;";
    private string _railStyle = "color:initial;";
    private bool _shouldRender = true;
    private double _lastUpdateDayCyclePosition;
    private int _lastUpdateTemperatureCelsius;

    private void OnRequestUiUpdate()
    {
        // Only update if temperature or day cycle changed enough to affect visuals significantly
        var temp = GameState.TemperatureCelsius;
        var dayP = GameState.DayCyclePosition;

        if (Math.Abs(dayP - _lastUpdateDayCyclePosition) > 0.001 || temp != _lastUpdateTemperatureCelsius)
        {
            _lastUpdateDayCyclePosition = dayP;
            _lastUpdateTemperatureCelsius = temp;
            _themeStyle = TemperatureThemeStyle();
            _railStyle = RailGradientStyle();
            _shouldRender = true;
            InvokeAsync(StateHasChanged);
        }
    }

    protected override bool ShouldRender()
    {
        if (_shouldRender)
        {
            _shouldRender = false;
            return true;
        }
        return false;
    }

    private async Task OnPointerDown(PointerEventArgs e)
    {
        _dragBounds = await JS.InvokeAsync<TrackBounds>("emojimentalField.getBounds", _trackRef);
        _pointerActive = true;
        await JS.InvokeVoidAsync("emojimentalField.setPointerCapture", _trackRef, e.PointerId);
        ApplyTemperatureFromClientY(e.ClientY);
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (!_pointerActive || _dragBounds is null) return;
        ApplyTemperatureFromClientY(e.ClientY);
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        if (_pointerActive)
        {
            await JS.InvokeVoidAsync("emojimentalField.releasePointerCapture", _trackRef, e.PointerId);
        }

        _pointerActive = false;
        _dragBounds = null;
    }

    private void ApplyTemperatureFromClientY(double clientY)
    {
        if (_dragBounds is not { Height: > 0 } bounds) return;

        var ratio = (clientY - bounds.Top) / bounds.Height;
        var range = SliderMax - SliderMin;
        var raw = SliderMax - ratio * range;
        var v = (int)Math.Round(raw, MidpointRounding.AwayFromZero);
        GameState.SetTemperature(v);
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        var current = GameState.TemperatureCelsius;
        switch (e.Key)
        {
            case "ArrowUp":
            case "ArrowRight":
                GameState.SetTemperature(current + 1);
                break;
            case "ArrowDown":
            case "ArrowLeft":
                GameState.SetTemperature(current - 1);
                break;
            case "Home":
                GameState.SetTemperature(-10);
                break;
            case "End":
                GameState.SetTemperature(GameState.MaxTemperatureCelsius);
                break;
            case "PageUp":
                GameState.SetTemperature(Math.Min(GameState.MaxTemperatureCelsius, current + 5));
                break;
            case "PageDown":
                GameState.SetTemperature(Math.Max(-10, current - 5));
                break;
            default:
                return;
        }
    }

    private string ThumbOffsetPercent() => MarkOffsetPercent(GameState.TemperatureCelsius);


    private string _cachedThemeStyle = "";
    private int _lastThemeTemperatureCelsius = int.MinValue;
    private double _lastThemeDayP = -1;

    private string TemperatureThemeStyle()
    {
        var progress = GameState.TemperatureProgress;
        var temperature = GameState.TemperatureCelsius;
        var dayP = GameState.DayCyclePosition;

        if (temperature == _lastThemeTemperatureCelsius && Math.Abs(dayP - _lastThemeDayP) < 0.001)
        {
            return _cachedThemeStyle;
        }

        _lastThemeTemperatureCelsius = temperature;
        _lastThemeDayP = dayP;

        var inv = System.Globalization.CultureInfo.InvariantCulture;
        
        var nightFactor = 0.85 + 0.15 * Math.Cos((dayP - 0.5) * 2.0 * Math.PI);

        string MixWithNight(
            int coldR, int coldG, int coldB,
            int warmR, int warmG, int warmB,
            int hotR, int hotG, int hotB,
            double alpha = 1.0)
        {
            return GameState.MixHeatColor(
                (int)(coldR * nightFactor), (int)(coldG * nightFactor), (int)(coldB * nightFactor),
                (int)(warmR * nightFactor), (int)(warmG * nightFactor), (int)(warmB * nightFactor),
                (int)(hotR * nightFactor), (int)(hotG * nightFactor), (int)(hotB * nightFactor),
                alpha);
        }

        _cachedThemeStyle = string.Format(inv, "--temperature-progress:{0:F3};--temperature-coldness:{1:F3};--sidebar-top:{2};--sidebar-bottom:{3};--sidebar-accent:{4};--sidebar-accent-strong:{5};--sidebar-accent-soft:{6};--sidebar-surface:{7};--sidebar-surface-strong:{8};--sidebar-border:{9};--sidebar-text:{10};--sidebar-label:{11};--sidebar-thumb:{12};--sidebar-shadow:{13};--sidebar-chip-shadow:{14};--sidebar-glow:{15};--clock-night:{16};--clock-dawn:{17};--clock-day:{18};",
            progress,
            1d - progress,
            MixWithNight(249, 252, 255, 255, 247, 239, 255, 225, 217),
            MixWithNight(229, 238, 252, 255, 225, 196, 255, 156, 124),
            MixWithNight(107, 139, 204, 255, 152, 94, 255, 82, 48),
            MixWithNight(73, 106, 181, 228, 113, 73, 221, 57, 32),
            MixWithNight(194, 218, 255, 255, 221, 186, 255, 190, 171, 0.92d),
            MixWithNight(255, 255, 255, 255, 249, 242, 255, 241, 236, 0.82d),
            MixWithNight(255, 255, 255, 255, 244, 233, 255, 230, 220, 0.94d),
            MixWithNight(216, 226, 243, 246, 205, 169, 237, 140, 120),
            MixWithNight(31, 42, 68, 104, 57, 37, 128, 36, 24),
            MixWithNight(91, 104, 128, 124, 82, 57, 144, 54, 40),
            MixWithNight(109, 115, 133, 255, 141, 93, 255, 96, 62),
            MixWithNight(46, 74, 122, 158, 83, 35, 166, 52, 28, 0.16d),
            MixWithNight(52, 78, 118, 160, 90, 43, 174, 61, 33, 0.14d),
            MixWithNight(126, 166, 235, 255, 176, 104, 255, 108, 72, 0.30d),
            GameState.MixHeatColor(29, 43, 93, 77, 81, 128, 108, 45, 61),
            GameState.MixHeatColor(248, 166, 108, 255, 171, 118, 255, 99, 75),
            GameState.MixHeatColor(135, 206, 235, 187, 229, 163, 255, 146, 112));
        
        return _cachedThemeStyle;
    }

    private string MarkOffsetPercent(int mark)
    {
        var range = SliderMax - SliderMin;
        return FormattableString.Invariant($"{((SliderMax - mark) / (double)range) * 100d:F2}%");
    }

    private IEnumerable<int> VisibleTemperatureMarks()
        => SliderMax > GameState.FirstVictoryTemperatureCelsius
            ? [-10, 0, 10, 20, 30, 40]
            : [-10, -5, 0, 5, 10, 15, 20];

    private static string FormatBonus(int percent)
        => $"{(percent >= 0 ? "+" : string.Empty)}{percent}%";

    private double ClockHandAngleDeg()
    {
        return GameState.DayCyclePosition * 360d;
    }

    private int DayNightEnergyBonusPercent()
    {
        var p = GameState.DayCyclePosition;
        // MidDay is p=0.5, MidNight is p=0
        // Sin(p * 2PI) is 0 at p=0, 1 at p=0.25, 0 at p=0.5, -1 at p=0.75
        // We want peak energy at MidDay (p=0.5).
        // Sin((p - 0.25) * 2PI) is:
        // p=0: Sin(-0.5PI) = -1
        // p=0.25: Sin(0) = 0
        // p=0.5: Sin(0.5PI) = 1 (MidDay)
        // p=0.75: Sin(PI) = 0
        return (int)Math.Round(Math.Sin((p - 0.25) * 2.0 * Math.PI) * 100d, MidpointRounding.AwayFromZero);
    }

    private string CurrentDateDisplay()
    {
        var daysElapsed = GameState.DaysElapsed;
        var date = GameStartDate.AddDays(daysElapsed);
        if (date > GameEndDate)
            date = GameEndDate;

        return $"{EmojiBank.Symbol(SymbolType.Calendar)} {date:dd--MM--yy}";
    }

    public void Dispose()
    {
        GameState.Changed -= OnGameStateChanged;
        GameState.RequestUiUpdate -= OnRequestUiUpdate;
    }

    private string RailGradientStyle()
    {
        var range = SliderMax - SliderMin;
        var maxTemp = Math.Min(GameState.MaxTemperatureCelsius, SliderMax);
        var maxTempPercent = ((SliderMax - maxTemp) / (double)range) * 100d;
        var firstVictoryPercent = ((SliderMax - GameState.FirstVictoryTemperatureCelsius) / (double)range) * 100d;
        
        var inv = System.Globalization.CultureInfo.InvariantCulture;

        var grey = "rgb(180, 185, 195)"; 
        var softFire = "rgb(255, 76, 54)";
        var softRed = "rgb(255, 126, 98)";
        var softBlue = "rgb(110, 160, 255)";
        
        return string.Format(
            inv,
            "background: linear-gradient(180deg, {0} 0%, {0} {1:F2}%, transparent {1:F2}%), linear-gradient(180deg, {2} 0%, {3} {4:F2}%, {5} 100%);",
            grey,
            maxTempPercent,
            softFire,
            softRed,
            firstVictoryPercent,
            softBlue);
    }


    private sealed class TrackBounds
    {
        public double Top { get; set; }
        public double Height { get; set; }
    }
}

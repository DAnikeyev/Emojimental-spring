@implements IDisposable
@inject GameState GameState
@inject IJSRuntime JS

@using Emojimental.Models
<aside class="temperature-sidebar">
    <div class="temperature-sidebar__top">
        <div class="temperature-sidebar__slider-shell">
            <div class="temperature-sidebar__vslider">
                <div class="temperature-sidebar__vslider-track">
                    <div class="temperature-sidebar__vslider-gutter"
                         @ref="_trackRef"
                         role="slider"
                         tabindex="0"
                         aria-valuemin="-10"
                         aria-valuemax="20"
                         aria-valuenow="@GameState.TemperatureCelsius"
                         aria-valuetext="@($"{GameState.TemperatureCelsius}°C")"
                         aria-label="Temperature in degrees Celsius"
                         @onpointerdown="OnPointerDown"
                         @onpointerdown:preventDefault="true"
                         @onpointermove="OnPointerMove"
                         @onpointerup="OnPointerUp"
                         @onpointercancel="OnPointerUp"
                         @onkeydown="OnKeyDown">
                        <div class="temperature-sidebar__vslider-rail" aria-hidden="true"></div>
                        <div class="temperature-sidebar__vslider-thumb"
                             style="top:@ThumbOffsetPercent()"
                             aria-hidden="true"></div>

                        @foreach (var mark in TemperatureMarks)
                        {
                            <div class="temperature-sidebar__vslider-mark" style="top:@MarkOffsetPercent(mark)">
                                <span class="temperature-sidebar__vslider-tick" aria-hidden="true"></span>
                                <span class="temperature-sidebar__vslider-label">@mark</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="temperature-sidebar__current">@EmojiBank.Symbol(SymbolType.Temperature) @GameState.TemperatureCelsius°</div>

        <div class="temperature-sidebar__bonuses">
            <div class="temperature-sidebar__bonus">
                <span>@EmojiBank.Resource(ResourceType.Ice) @FormatBonus(GameState.GetSnowTemperatureBonusPercent())</span>
                <span>@EmojiBank.Resource(ResourceType.Water) @FormatBonus(GameState.GetWaterTemperatureBonusPercent())</span>
                <span>@EmojiBank.Resource(ResourceType.Energy) @FormatBonus(GameState.GetEnergyTemperatureBonusPercent())</span>
            </div>
        </div>
    </div>

    <div class="temperature-sidebar__bottom">
        <div class="temperature-sidebar__clock" aria-label="Day-night cycle">
            <div class="temperature-sidebar__clock-face">
                <span class="temperature-sidebar__clock-sun" aria-hidden="true">@EmojiBank.Symbol(SymbolType.Sun)</span>
                <span class="temperature-sidebar__clock-moon" aria-hidden="true">@EmojiBank.Symbol(SymbolType.Moon)</span>
                <div class="temperature-sidebar__clock-hand"
                     style="transform: rotate(@ClockHandAngleDeg().ToString("F1", System.Globalization.CultureInfo.InvariantCulture)deg)">
                </div>
                <div class="temperature-sidebar__clock-center"></div>
            </div>
        </div>
        <div class="temperature-sidebar__daynight-bonus">
            <span>@EmojiBank.Resource(ResourceType.Energy)</span>
            <span>@FormatBonus(DayNightEnergyBonusPercent())</span>
        </div>
        <div class="temperature-sidebar__date">@CurrentDateDisplay()</div>
    </div>
</aside>

@code {
    private static readonly int[] TemperatureMarks = [-10, -5, 0, 5, 10, 15, 20];
    private static readonly DateTime GameStartDate = new(2026, 4, 1);
    private static readonly DateTime GameEndDate = new(2026, 5, 31);

    private ElementReference _trackRef;
    private TrackBounds? _dragBounds;
    private bool _pointerActive;

    private DateTime _lastUpdate = DateTime.MinValue;

    protected override void OnInitialized()
    {
        GameState.Changed += OnGameStateChanged;
        GameState.RequestUiUpdate += OnRequestUiUpdate;
    }

    private void OnGameStateChanged()
    {
        // Handled by RequestUiUpdate
    }

    private void OnRequestUiUpdate()
    {
        var now = DateTime.UtcNow;
        if ((now - _lastUpdate).TotalMilliseconds >= 500)
        {
            _lastUpdate = now;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnPointerDown(PointerEventArgs e)
    {
        _dragBounds = await JS.InvokeAsync<TrackBounds>("emojimentalField.getBounds", _trackRef);
        _pointerActive = true;
        await JS.InvokeVoidAsync("emojimentalField.setPointerCapture", _trackRef, e.PointerId);
        ApplyTemperatureFromClientY(e.ClientY);
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (!_pointerActive || _dragBounds is null) return;
        ApplyTemperatureFromClientY(e.ClientY);
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        if (_pointerActive)
        {
            await JS.InvokeVoidAsync("emojimentalField.releasePointerCapture", _trackRef, e.PointerId);
        }

        _pointerActive = false;
        _dragBounds = null;
    }

    private void ApplyTemperatureFromClientY(double clientY)
    {
        if (_dragBounds is not { Height: > 0 } bounds) return;

        var ratio = (clientY - bounds.Top) / bounds.Height;
        var raw = 20d - ratio * 30d;
        var v = (int)Math.Round(raw, MidpointRounding.AwayFromZero);
        GameState.SetTemperature(v);
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        var current = GameState.TemperatureCelsius;
        switch (e.Key)
        {
            case "ArrowUp":
            case "ArrowRight":
                GameState.SetTemperature(current + 1);
                break;
            case "ArrowDown":
            case "ArrowLeft":
                GameState.SetTemperature(current - 1);
                break;
            case "Home":
                GameState.SetTemperature(-10);
                break;
            case "End":
                GameState.SetTemperature(20);
                break;
            case "PageUp":
                GameState.SetTemperature(Math.Min(20, current + 5));
                break;
            case "PageDown":
                GameState.SetTemperature(Math.Max(-10, current - 5));
                break;
            default:
                return;
        }
    }

    private string ThumbOffsetPercent() => MarkOffsetPercent(GameState.TemperatureCelsius);

    private static string MarkOffsetPercent(int mark)
        => FormattableString.Invariant($"{((20d - mark) / 30d) * 100d:F2}%");

    private static string FormatBonus(int percent)
        => $"{(percent >= 0 ? "+" : string.Empty)}{percent}%";

    private double ClockHandAngleDeg()
    {
        return GameState.DayCyclePosition * 360d;
    }

    private int DayNightEnergyBonusPercent()
    {
        var p = GameState.DayCyclePosition;
        // MidDay is p=0.5, MidNight is p=0
        // Sin(p * 2PI) is 0 at p=0, 1 at p=0.25, 0 at p=0.5, -1 at p=0.75
        // We want peak energy at MidDay (p=0.5).
        // Sin((p - 0.25) * 2PI) is:
        // p=0: Sin(-0.5PI) = -1
        // p=0.25: Sin(0) = 0
        // p=0.5: Sin(0.5PI) = 1 (MidDay)
        // p=0.75: Sin(PI) = 0
        return (int)Math.Round(Math.Sin((p - 0.25) * 2.0 * Math.PI) * 100d, MidpointRounding.AwayFromZero);
    }

    private string CurrentDateDisplay()
    {
        var daysElapsed = (int)(GameState.PlayTime.TotalMinutes);
        var date = GameStartDate.AddDays(daysElapsed);
        if (date > GameEndDate)
            date = GameEndDate;

        return $"{date:MMM dd}";
    }

    public void Dispose()
    {
        GameState.Changed -= OnGameStateChanged;
        GameState.RequestUiUpdate -= OnRequestUiUpdate;
    }

    private sealed class TrackBounds
    {
        public double Top { get; set; }
        public double Height { get; set; }
    }
}

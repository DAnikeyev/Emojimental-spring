@using Emojimental.Models
<aside class="left-sidebar">
    <nav class="left-sidebar__menu">
        <div class="left-sidebar__menu-item @(ActiveMenu == "Factory" ? "left-sidebar__menu-item--active" : "")" 
             @onclick='() => SetMenu("Factory")' title="Factory">
            @EmojiBank.Symbol(SymbolType.Factory)
        </div>
        <div class="left-sidebar__menu-item @(ActiveMenu == "Research" ? "left-sidebar__menu-item--active" : "")" 
             @onclick='() => SetMenu("Research")' title="Research">
            @EmojiBank.Symbol(SymbolType.Research)
        </div>
        <div class="left-sidebar__menu-item @(ActiveMenu == "Stars" ? "left-sidebar__menu-item--active" : "")" 
             @onclick='() => SetMenu("Stars")' title="Stars">
            @EmojiBank.Symbol(SymbolType.Stars)
        </div>
    </nav>

    <div class="left-sidebar__content">
        <div class="left-sidebar__content-top">
            @switch (ActiveMenu)
            {
                case "Factory":
                    <FactoryMenu />
                    break;
                case "Research":
                    <ResearchMenu />
                    break;
                case "Stars":
                    <StarsMenu />
                    break;
            }
        </div>
        <div class="left-sidebar__content-bottom">
            <ExchangeMenu />
        </div>
    </div>
</aside>

@code {
    private string ActiveMenu { get; set; } = "Factory";

    private void SetMenu(string menu)
    {
        ActiveMenu = menu;
    }
}

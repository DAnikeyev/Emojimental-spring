@using Microsoft.AspNetCore.Components.Web
@using Emojimental.Models
@implements IDisposable
@inject Services.GameState GameState

<section class="left-sidebar__section left-sidebar__section--stars">
    <div style="display: flex; gap: 0.5rem; width: 100%;">
        <button type="button"
                class="left-sidebar__button"
                style="flex: 1;"
                @onclick="SortStars"
                aria-label="Sort stars">
            🌟⬇️
        </button>
        @if (GameState.CountFieldObjects(FieldNodeType.Recycler) > 0)
        {
            <button type="button"
                    class="left-sidebar__button"
                    style="flex: 1;"
                    @onclick="SendToRecycler"
                    aria-label="Recycle lowest yellow star">
                🌟➡️♻️
            </button>
        }
    </div>
    <div class="left-sidebar__star-grid" aria-label="Star inventory">
        @foreach (var starSlot in GameState.StarInventory)
        {
            var star = starSlot.Star;
            var hasStar = starSlot.HasStar;
            var isDragging = GameState.DraggingStarSlotIndex == starSlot.Index;
            var canDrop = GameState.CanDropStarIntoInventory(starSlot.Index);
            
            var starBgStyle = "";
            if (star != null)
            {
                starBgStyle = star.Type switch
                {
                    StarType.Legendary => "background-color: orange;",
                    StarType.Blue => "background-color: blue;",
                    _ => ""
                };
            }

            var starSlotClasses = $"left-sidebar__star-slot{(hasStar ? " left-sidebar__star-slot--filled" : string.Empty)}{(isDragging ? " left-sidebar__star-slot--dragging" : string.Empty)}{(canDrop ? " left-sidebar__star-slot--drop-target" : string.Empty)}";

            <div class="@starSlotClasses"
                 @ondragover:preventDefault="true"
                 @ondrop="@(() => GameState.MoveStarInInventory(starSlot.Index))">
                @if (hasStar)
                {
                    <div class="left-sidebar__star-shell">
                        <button type="button"
                                class="left-sidebar__star"
                                draggable="true"
                                @ondragstart="@(args => OnStarDragStart(starSlot.Index, args))"
                                @ondragend="OnStarDragEnd"
                                @onmouseenter="@(e => OnStarHover(star!, e))"
                                @onmouseleave="OnStarHoverEnd"
                                aria-label="Star modifiers">
                            <div class="left-sidebar__star-icon @(star?.Type == StarType.Legendary ? "star--legendary" : star?.Type == StarType.Blue ? "star--rare" : "")">
                                @EmojiBank.Symbol(SymbolType.Stars)
                            </div>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private DateTime _lastUpdate = DateTime.MinValue;

    protected override void OnInitialized()
    {
        GameState.RequestUiUpdate += OnRequestUiUpdate;
    }

    private void OnRequestUiUpdate()
    {
        var now = DateTime.UtcNow;
        if ((now - _lastUpdate).TotalMilliseconds >= 500)
        {
            _lastUpdate = now;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        GameState.RequestUiUpdate -= OnRequestUiUpdate;
    }

    private void OnStarDragStart(int inventorySlotIndex, DragEventArgs _)
    {
        GameState.BeginStarDrag(inventorySlotIndex);
        GameState.SetHoveredStar(null);
    }

    private void OnStarDragEnd(DragEventArgs _)
        => GameState.EndStarDrag();

    private void OnStarHover(Star star, MouseEventArgs e)
    {
        if (GameState.DraggingStarSlotIndex is null)
        {
            GameState.SetHoveredStar(star, e.ClientX, e.ClientY, HoverSide.Left);
        }
    }

    private void OnStarHoverEnd()
    {
        GameState.SetHoveredStar(null);
    }

    private void SortStars()
    {
        GameState.SortStarInventoryByRarityAndMultiplier();
    }

    private void SendToRecycler()
    {
        GameState.SendLowestYellowStarToRecycler();
    }
}


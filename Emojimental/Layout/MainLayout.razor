@using Emojimental.Components
@inherits LayoutComponentBase
@implements IDisposable
@inject GameState GameState

<div class="page">
    <header class="top-row">
        <div class="top-row__brand" aria-label="Emojimental">✨</div>

        <div class="top-row__resources">
            <ResourceBar />
        </div>
    </header>

    <main>
        <article class="content">
            @Body
        </article>
    </main>

    <Snowfall />
</div>

@code {
    protected override void OnInitialized()
    {
        GameState.Changed += OnGameStateChanged;
        GameState.RequestUiUpdate += OnRequestUiUpdate;
    }

    private void OnGameStateChanged()
    {
        StateHasChanged();
    }

    private void OnRequestUiUpdate()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameState.Changed -= OnGameStateChanged;
        GameState.RequestUiUpdate -= OnRequestUiUpdate;
    }
}

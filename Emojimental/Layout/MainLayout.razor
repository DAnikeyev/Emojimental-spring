@inherits LayoutComponentBase
@implements IDisposable
@inject GameState GameState

<div class="page">
    <header class="top-row">
        <div class="top-row__brand" aria-label="Emojimental">✨</div>

        <div class="top-row__resources">
            <div class="top-row__resource" aria-label="Energy">⚡ <strong>@FormatResource(GameState.Energy)</strong></div>
            <div class="top-row__resource" aria-label="Ice">🧊 <strong>@FormatResource(GameState.Ice)</strong></div>
            <div class="top-row__resource" aria-label="Coin">💰 <strong>@FormatResource(GameState.Coin)</strong></div>
            <div class="top-row__resource" aria-label="Sapling">🌱 <strong>@FormatResource(GameState.Sapling)</strong></div>
            <div class="top-row__resource" aria-label="Tree">🌲 <strong>@FormatResource(GameState.Tree)</strong></div>
            <div class="top-row__resource" aria-label="Water">💧 <strong>@FormatResource(GameState.Water)</strong></div>
        </div>
    </header>

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        GameState.Changed += OnGameStateChanged;
    }

    private void OnGameStateChanged() => InvokeAsync(StateHasChanged);

    private static string FormatResource(BigDouble value)
        => value.Display();

    public void Dispose()
    {
        GameState.Changed -= OnGameStateChanged;
    }
}
